// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tenant represents an organization or customer using the platform
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resourceGroups ResourceGroup[]
  bookingPolicies BookingPolicy[]
  users          User[]

  @@map("tenants")
}

// User model for authentication and ownership
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(USER)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  reviews      ResourceReview[]
  notifications Notification[]
  auditLogs    AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

// ResourceGroup organizes resources by type (rooms, equipment, staff, etc.)
model ResourceGroup {
  id         String               @id @default(uuid())
  tenantId   String
  name       String
  type       ResourceType
  configJson Json?                // Additional configuration as JSON
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resources    Resource[]
  openingHours OpeningHours[]

  @@map("resource_groups")
}

enum ResourceType {
  ROOM
  PERSON
  EQUIPMENT
  VEHICLE
  CUSTOM
}

// Resource represents a bookable entity
model Resource {
  id          String   @id @default(uuid())
  groupId     String
  name        String
  description String?
  capacity    Int?     // Number of people/items it can accommodate
  metaJson    Json?    // Additional metadata as JSON
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group        ResourceGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  openingHours OpeningHours[]
  reservations Reservation[]
  reviews      ResourceReview[]
  exceptions   ResourceException[]

  @@map("resources")
}

// OpeningHours defines when a resource or group is available
model OpeningHours {
  id          String   @id @default(uuid())
  resourceId  String?  // If set, applies to specific resource
  groupId     String?  // If set, applies to all resources in group
  weekday     Int      // 0-6 (Sunday-Saturday)
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resource Resource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  group    ResourceGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("opening_hours")
}

// Reservation represents a booking
model Reservation {
  id                String            @id @default(uuid())
  resourceId        String
  userId            String?           // Optional: for anonymous bookings
  startsAt          DateTime
  endsAt            DateTime
  status            ReservationStatus @default(PENDING)
  metaJson          Json?             // Additional metadata (customer info, notes, etc.)
  stripePaymentId   String?           // For payment tracking
  cancellationNote  String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  review   ResourceReview?
  recurrence ReservationRecurrence?

  @@index([resourceId, startsAt, endsAt])
  @@index([status])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// BookingPolicy defines rules for booking
model BookingPolicy {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  rulesJson Json     // Contains: cancellationDeadlineHours, maxDurationHours, minDurationMinutes, advanceBookingDays, etc.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("booking_policies")
}

// ResourceReview allows users to rate and review resources after use
model ResourceReview {
  id            String   @id @default(uuid())
  resourceId    String
  userId        String
  reservationId String   @unique
  rating        Int      // 1-5 stars
  comment       String?
  isPublic      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([rating])
  @@map("resource_reviews")
}

// ReservationRecurrence handles recurring bookings (daily, weekly, monthly)
model ReservationRecurrence {
  id             String             @id @default(uuid())
  reservationId  String             @unique // Links to the parent/first reservation
  pattern        RecurrencePattern
  interval       Int                @default(1) // Every N days/weeks/months
  daysOfWeek     Int[]              // For weekly: [1,3,5] = Mon, Wed, Fri
  dayOfMonth     Int?               // For monthly: 15 = 15th of month
  endsAt         DateTime?          // End date for recurrence
  occurrences    Int?               // Or max number of occurrences
  exceptions     DateTime[]         // Dates to skip
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_recurrences")
}

enum RecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

// Notification tracks outbound notifications (email, SMS, push, etc.)
model Notification {
  id          String             @id @default(uuid())
  userId      String?            // Optional: system notifications have no user
  type        NotificationType
  channel     NotificationChannel
  recipientEmail String?
  recipientPhone String?
  subject     String?
  body        String
  metaJson    Json?              // Additional data (reservation ID, etc.)
  status      NotificationStatus @default(PENDING)
  sentAt      DateTime?
  failureReason String?
  retryCount  Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@map("notifications")
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_REMINDER
  PAYMENT_RECEIVED
  REVIEW_REQUEST
  SYSTEM_ANNOUNCEMENT
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// AuditLog provides complete audit trail for compliance and debugging
model AuditLog {
  id         String   @id @default(uuid())
  entityType String   // e.g., "Reservation", "Resource"
  entityId   String
  action     String   // e.g., "CREATE", "UPDATE", "DELETE"
  userId     String?
  changes    Json?    // Before/after values
  metadata   Json?    // Additional context
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ResourceException allows marking resources unavailable for specific periods
model ResourceException {
  id          String               @id @default(uuid())
  resourceId  String
  startsAt    DateTime
  endsAt      DateTime
  reason      String
  type        ResourceExceptionType
  createdBy   String?              // User ID who created the exception
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, startsAt, endsAt])
  @@map("resource_exceptions")
}

enum ResourceExceptionType {
  MAINTENANCE
  BLOCKED
  HOLIDAY
  SPECIAL_EVENT
}
